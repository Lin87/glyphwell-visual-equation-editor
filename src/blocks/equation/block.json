{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glyphwell/equation",
	"version": "1.0.1",
	"title": "Equation",
	"category": "text",
	"description": "Create and display a mathematical equation.",
	"textdomain": "glyphwell",
	"attributes": {
		"latex": {
			"type": "string",
			"default": ""
		},
		"mathML": {
			"type": "string",
			"default": ""
		},
		"textAlign": {
			"type": "string",
			"enum": [ "left", "center", "right" ],
			"default": "center"
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
