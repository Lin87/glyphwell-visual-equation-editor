{
	"name": "equation-editor",
	"version": "0.1.0",
	"description": "A WordPress equation editor block and inline equation formatter.",
	"author": "Ethan Lin",
	"license": "GPL-2.0-or-later",
	"private": true,
	"files": [
		"assets/screenshots/",
		"build/",
		"equation-editor.php",
		"includes/",
		"languages/",
		"LICENSE",
		"readme.txt",
		"src/"
	],
	"scripts": {
		"start": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"make-pot": "node ./bin/make-pot.js",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-e2e",
		"ship": "npm run make-pot && npm run build && wp-scripts plugin-zip"
	},
	"dependencies": {
		"katex": "^0.16.45",
		"mathlive": "^0.109.2"
	},
	"devDependencies": {
		"@wordpress/icons": "^13.0.0",
		"@wordpress/scripts": "^32.1.0",
		"gettext-extractor": "^4.0.6",
		"postcss": "^8.5.14"
	}
}
