{
	"name": "glyphwell-visual-equation-editor",
	"version": "1.0.1",
	"description": "A WordPress equation editor block and inline equation formatter.",
	"author": "Ethan Lin",
	"license": "GPL-2.0-or-later",
	"private": true,
	"files": [
		"build/",
		"glyphwell.php",
		"includes/",
		"languages/",
		"LICENSE",
		"readme.txt",
		"src/"
	],
	"scripts": {
		"start": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"make-pot": "node ./bin/make-pot.js",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-e2e",
		"ship": "npm run make-pot && npm run build && wp-scripts plugin-zip"
	},
	"dependencies": {
		"katex": "^0.19.1",
		"mathlive": "^0.111.1"
	},
	"devDependencies": {
		"@wordpress/icons": "^19.0.0",
		"@wordpress/scripts": "^37.0.0",
		"gettext-extractor": "^4.0.6",
		"postcss": "^8.5.31"
	}
}
